{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "realstay-inappnotificationservice",
  "main": "src/index.ts",
  // Turned off on 2026-11-18: the RealStay backend has all the features.
  "workers_dev": false,
  "compatibility_date": "2026-04-06",
  "vars": {
    "BACKEND_URL": "https://real-stay-backend-3c90072b0570.herokuapp.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fcm-tokens",
      "database_id": "f8c9c1b9-ae06-4253-838a-9d7753e03320",
      "migrations_dir": "./drizzle",
    },
  ],
